# PartTrack Environment Configuration Example
#
# Server-side Gemini AI Vision API Key
# For Node/Express runtime: define in .env
# For Cloudflare Worker runtime: configure as a secret via `wrangler secret put GEMINI_API_KEY`
#   or in the Cloudflare Dashboard under Settings > Variables and Secrets
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Configurable primary and secondary fallback Gemini models for OCR extraction
# When the primary model experiences HTTP 503 / 429 high demand after 3 exponential backoff retries,
# PalletTrack automatically fails over to the secondary model(s) with identical schema & instructions.
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-flash-latest

# Optional: One-time initial Super Admin setup secret (defaults to PALLETTRACK-SETUP-2026 if unset)
# INITIAL_SETUP_SECRET=PALLETTRACK-SETUP-2026

# Optional: Custom Cloudflare Worker URL if the frontend is hosted on a different domain
# VITE_CLOUDFLARE_WORKER_URL=https://parttrack.<your-subdomain>.workers.dev

