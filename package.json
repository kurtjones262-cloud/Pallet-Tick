{
  "name": "pallettick-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild worker.ts --platform=neutral --format=esm --outfile=build/worker.js --bundle && esbuild server.ts --platform=node --format=esm --outfile=server.js --bundle --packages=external",
    "build:static": "vite build",
    "build:worker": "vite build && esbuild worker.ts --platform=neutral --format=esm --outfile=build/worker.js --bundle",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy",
    "start": "node server.ts",
    "preview": "vite preview",
    "preview:worker": "wrangler dev",
    "clean": "rm -rf dist build server.js",
    "lint": "tsc --noEmit",
    "mobile:sync": "vite build && npx cap sync",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:release": "vite build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:bundle": "vite build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "ios:sync": "vite build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jszip": "^3.4.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.158.0"
  }
}
